# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: HMAC signing secret for JWT access tokens and session signatures (required in production).
AUTH_SECRET="change_me_in_production"

# PASSWORD_PEPPER: Secret pepper for optional password-uniqueness HMAC.
PASSWORD_PEPPER="change_me_pepper_in_production"

# ADMIN BOOTSTRAP CREDENTIALS (used idempotently by migration 008 on fresh/initial setup; change via Admin Security Settings after login)
ADMIN_USERNAME="admin_username"
ADMIN_FULL_NAME="Admin Full Name"
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace_with_initial_password"
ADMIN_INITIAL_PASSKEY="replace_with_initial_passkey"
ADMIN_FORCE_CREDENTIAL_CHANGE="false"

# AUTH & SESSION POLICY
SESSION_IDLE_TIMEOUT_MS="1200000"
ENFORCE_GLOBAL_UNIQUE_PASSWORD="false"
FORGOT_USERNAME_MODE="reset"

# SUBSCRIPTION LIFECYCLE POLICY
SUBSCRIPTION_RENEWAL_MODE="reset"
SUBSCRIPTION_EXPIRY_SWEEP_MS="300000"

# SUPPORT_EMAIL: Centralized customer support contact email.
SUPPORT_EMAIL="buyoll@customerservive.com"

# LOAN_PLATFORM_FEE_RATE: Platform loan fee rate (0.01 = 1%).
LOAN_PLATFORM_FEE_RATE="0.01"

# CORS & FRONTEND DEPLOYMENT
FRONTEND_URL="https://buyoll.example.com"
CORS_ORIGINS="http://localhost:3000,https://buyoll.example.com"
# Client build env (set in Vercel / GitHub Actions if backend runs on a separate origin):
# VITE_API_URL="https://api.buyoll.example.com/api"

# EMAIL PROVIDER CONFIG (Resend; leave empty for dev server-console logging)
EMAIL_FROM="Buyoll <no-reply@buyoll.com>"
RESEND_API_KEY=""

# SMS PROVIDER CONFIG (Africa's Talking; leave empty for dev server-console logging)
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID="BUYOLL"
