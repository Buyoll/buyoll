# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SETUP_KEY: One-time setup key required to register the single platform administrator account.
ADMIN_SETUP_KEY="your_secret_admin_setup_key_here"

# AUTH_SECRET: HMAC signing secret for JWT access tokens in production.
AUTH_SECRET="change_me_in_production"

# SUPPORT_EMAIL: Centralized customer support contact email.
SUPPORT_EMAIL="buyoll@customerservive.com"

# LOAN_PLATFORM_FEE_RATE: Platform loan fee rate (0.01 = 1%).
LOAN_PLATFORM_FEE_RATE="0.01"
